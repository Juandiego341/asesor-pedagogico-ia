# Base de datos (Neon): Dashboard → Connection string (incluye sslmode=require)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Firma de sesiones (cadena aleatoria larga)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Administrador inicial (se crea solo si la base está vacía)
ADMIN_EMAIL=admin@asesor.edu.co
ADMIN_PASSWORD=Admin2026!
# Origen del frontend (si se llama la API directamente desde otro dominio)
CORS_ORIGINS=http://localhost:3000
# Modelo por defecto: demo | anthropic | openai | gemini | ollama (se puede cambiar desde Administración)
AI_PROVIDER=demo
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
# Opcional: evita el límite de peticiones de GitHub al descargar repositorios
GITHUB_TOKEN=
# Opcional
EVAL_CONCURRENCY=2
ALLOW_SIGNUP=true
